# Proxy inverso con HTTPS automático (Let's Encrypt). Guía: docs/operations/docker-ec2.md
# YUMORI_DOMAIN sale del archivo .env de la EC2 (ej.: YUMORI_DOMAIN=yumori.cl). Sin él usa "localhost" con un certificado interno de prueba.
# Next llega por `api:3000`: `web` comparte la red de `api` (docker-compose.yml). El 8000 de Python escucha solo en loopback y no se expone.
# Los encabezados de seguridad y la CSP los pone Next (frontend/proxy.ts); aquí no se tocan.

{$YUMORI_DOMAIN:localhost} {
	encode zstd gzip
	# Clave pública de Web Bot Auth del scraper (scrapers/webbotauth.py, ADR-010). Si se cambia data/webbotauth.key, regenerar con
	# `python -m scrapers.webbotauth directorio`. La respuesta va firmada (Cloudflare lo exige para registrar el bot): las dos líneas
	# Signature salen de `python -m scrapers.webbotauth firmar-directorio` y VENCEN A LOS 90 DÍAS (fecha en docs/decisions/ADR-010).
	@wba path /.well-known/http-message-signatures-directory
	header @wba Content-Type application/http-message-signatures-directory+json
	header @wba Cache-Control max-age=86400
	header @wba Signature-Input `sig1=("@authority";req);created=1795577750;expires=1803353750;keyid="q8CSm6jYy8GQ0YIyGxTYjh11QXtB7oMTMMVy2oVFoK8";alg="ed25519";tag="http-message-signatures-directory"`
	header @wba Signature `sig1=:tL8Crm5gAXvjD6EnqN2RgV9z43dravzaFD3hFDGqFKnuYmFhl2U0+4MRoa1LJlWsgKu9t1gOs8yegZhHou1VDQ==:`
	respond @wba `{"keys": [{"kty": "OKP", "crv": "Ed25519", "x": "qdS8duRC9jIOxsduqsUKSdSUjvIEmRSNWEBagzWK6Es"}]}` 200
	reverse_proxy api:3000
}

www.{$YUMORI_DOMAIN:localhost} {
	redir https://{$YUMORI_DOMAIN:localhost}{uri} permanent
}
